#!/usr/bin/env bash
set -euo pipefail

# SentinelMesh NSM
# Purpose: Print a firstboot reminder when no SentinelMesh profile has been selected.
# Inputs: /etc/sentinelmesh/profile presence.
# Outputs: Console and journal message.
# Safe to re-run: yes.

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: sm-firstboot-reminder"
  exit 0
fi

cat <<'EOF'

SentinelMesh NSM is installed, but no deployment profile has been selected yet.

Run:

  sudo sm-setup

Profiles:

  1) Standalone NSM
  2) Manager / Search Node
  3) Sensor Node
  4) Cyber Range Node
  5) Developer / Lab Node
  6) Dedicated Manager Node
  7) Dedicated Search Node
  8) Receiver Node

EOF
