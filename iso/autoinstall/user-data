#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: sentinelmesh
    username: sentinel
    password: "$6$rounds=4096$replace-this-hash-before-build"
  ssh:
    install-server: true
    allow-pw: false
  packages:
    - ansible
    - ca-certificates
    - chrony
    - cloud-init
    - curl
    - git
    - jq
    - nftables
    - openssh-server
    - python3
    - python3-pip
    - yq
  late-commands:
    - curtin in-target --target=/target -- mkdir -p /opt/sentinelmesh /etc/sentinelmesh /var/log/sentinelmesh /data/sentinelmesh
    - curtin in-target --target=/target -- chmod 755 /opt/sentinelmesh
    - curtin in-target --target=/target -- systemctl enable ssh
    - mkdir -p /target/opt/sentinelmesh/source
    - cp -a /cdrom/sentinelmesh/payload/. /target/opt/sentinelmesh/source/
    - curtin in-target --target=/target -- bash -lc 'cd /opt/sentinelmesh/source && ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook -i ansible/inventory.ini ansible/site.yml'
