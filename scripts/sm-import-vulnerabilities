#!/usr/bin/env bash
set -euo pipefail

# SentinelMesh NSM
# Purpose: Stage vulnerability scanner findings for asset-context ingestion.
# Inputs: JSON vulnerability import file.
# Outputs: Copied import file under /data/sentinelmesh/imports/vulnerabilities.
# Safe to re-run: yes.

LOG_DIR="/var/log/sentinelmesh"
LOG_FILE="$LOG_DIR/sm-import-vulnerabilities.log"
IMPORT_DIR="${SENTINELMESH_VULN_IMPORT_DIR:-/data/sentinelmesh/imports/vulnerabilities}"
INPUT_FILE=""

usage() {
  cat <<'EOF'
Usage: sm-import-vulnerabilities --file PATH

Stages a SentinelMesh vulnerability import JSON file for future asset-context
ingestion. MVP validates JSON syntax and stores the file.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --file)
      INPUT_FILE="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

mkdir -p "$LOG_DIR" "$IMPORT_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1

if [[ -z "$INPUT_FILE" || ! -f "$INPUT_FILE" ]]; then
  usage
  exit 1
fi

if ! python3 -m json.tool "$INPUT_FILE" >/dev/null; then
  echo "Invalid JSON: $INPUT_FILE"
  exit 1
fi

DEST="$IMPORT_DIR/$(date -u +%Y%m%dT%H%M%SZ)-$(basename "$INPUT_FILE")"
cp "$INPUT_FILE" "$DEST"
chmod 600 "$DEST"

echo "Vulnerability import staged: $DEST"
