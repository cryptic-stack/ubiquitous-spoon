{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelmesh.local/schemas/asset-context.schema.json",
  "title": "SentinelMesh Asset Context",
  "type": "object",
  "required": [
    "asset_id",
    "ip_addresses",
    "mac_addresses",
    "hostnames",
    "first_seen",
    "last_seen",
    "risk_score",
    "criticality",
    "vulnerabilities",
    "exposure"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "Stable UUID or deterministic asset identifier."
    },
    "ip_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mac_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hostnames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fqdn": {
      "type": "string"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "os_guess": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "open_ports": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "users_observed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "criticality": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "scanner": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "cvss": {
            "type": "number"
          },
          "first_seen": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "exposure": {
      "type": "object",
      "required": ["internet_facing", "internal_only"],
      "properties": {
        "internet_facing": {
          "type": "boolean"
        },
        "internal_only": {
          "type": "boolean"
        }
      }
    }
  }
}

