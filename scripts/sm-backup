#!/usr/bin/env bash
set -euo pipefail

# SentinelMesh NSM
# Purpose: Create a SentinelMesh configuration backup archive.
# Inputs: /etc/sentinelmesh and selected metadata.
# Outputs: Timestamped tar.gz backup archive.
# Safe to re-run: yes.

LOG_DIR="/var/log/sentinelmesh"
LOG_FILE="$LOG_DIR/sm-backup.log"
OUTPUT_DIR="/data/sentinelmesh/backups"

usage() {
  cat <<'EOF'
Usage: sm-backup [--output-dir PATH]

Creates a timestamped backup archive containing SentinelMesh configuration,
secrets, and lightweight metadata. Packet captures and OpenSearch data are not
included in this MVP backup.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-dir)
      OUTPUT_DIR="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

mkdir -p "$LOG_DIR" "$OUTPUT_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1

TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
ARCHIVE="$OUTPUT_DIR/sentinelmesh-backup-$TIMESTAMP.tar.gz"
MANIFEST="$(mktemp)"

cat > "$MANIFEST" <<EOF
created_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
hostname: $(hostname)
profile: $(cat /etc/sentinelmesh/profile 2>/dev/null || echo unknown)
includes:
  - /etc/sentinelmesh
  - /opt/sentinelmesh/profiles
  - /opt/sentinelmesh/compose
  - /opt/sentinelmesh/configs
excludes:
  - packet captures
  - OpenSearch data
  - Docker volumes
EOF

tar -czf "$ARCHIVE" \
  -C / "$MANIFEST" \
  etc/sentinelmesh \
  opt/sentinelmesh/profiles \
  opt/sentinelmesh/compose \
  opt/sentinelmesh/configs

rm -f "$MANIFEST"
chmod 600 "$ARCHIVE"

echo "Backup created: $ARCHIVE"
