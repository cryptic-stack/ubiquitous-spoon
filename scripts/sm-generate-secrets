#!/usr/bin/env bash
set -euo pipefail

# SentinelMesh NSM
# Purpose: Generate local appliance secrets.
# Inputs: None.
# Outputs: Secret files under /etc/sentinelmesh/secrets.
# Safe to re-run: yes, existing secrets are preserved.

LOG_DIR="/var/log/sentinelmesh"
LOG_FILE="$LOG_DIR/sm-generate-secrets.log"
SECRET_DIR="/etc/sentinelmesh/secrets"

usage() {
  cat <<'EOF'
Usage: sm-generate-secrets

Generates missing SentinelMesh local secrets.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

mkdir -p "$LOG_DIR" "$SECRET_DIR"
chmod 700 "$SECRET_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1

if [[ ! -f "$SECRET_DIR/opensearch-admin-password" ]]; then
  openssl rand -base64 36 > "$SECRET_DIR/opensearch-admin-password"
fi

chmod 600 "$SECRET_DIR"/*
echo "Secrets are present in $SECRET_DIR"

