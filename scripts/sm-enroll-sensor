#!/usr/bin/env bash
set -euo pipefail

# SentinelMesh NSM
# Purpose: Save manager enrollment settings on a sensor node.
# Inputs: Manager URL and enrollment token.
# Outputs: /etc/sentinelmesh/sensor-enrollment.yml.
# Safe to re-run: yes, overwrites sensor enrollment settings.

LOG_DIR="/var/log/sentinelmesh"
LOG_FILE="$LOG_DIR/sm-enroll-sensor.log"
OUTPUT_FILE="/etc/sentinelmesh/sensor-enrollment.yml"

usage() {
  cat <<'EOF'
Usage: sm-enroll-sensor --manager-url URL --token TOKEN [--sensor-name NAME]

Stores enrollment settings for a SentinelMesh sensor.
EOF
}

MANAGER_URL=""
TOKEN=""
SENSOR_NAME="$(hostname)"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --manager-url)
      MANAGER_URL="${2:-}"
      shift 2
      ;;
    --token)
      TOKEN="${2:-}"
      shift 2
      ;;
    --sensor-name)
      SENSOR_NAME="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
done

mkdir -p "$LOG_DIR" /etc/sentinelmesh
exec > >(tee -a "$LOG_FILE") 2>&1

if [[ -z "$MANAGER_URL" || -z "$TOKEN" ]]; then
  usage
  exit 1
fi

cat > "$OUTPUT_FILE" <<EOF
sensor_name: $SENSOR_NAME
manager_url: $MANAGER_URL
enrollment_token: $TOKEN
enrolled_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
status: pending-validation
EOF

chmod 600 "$OUTPUT_FILE"
echo "Sensor enrollment settings written to $OUTPUT_FILE"
